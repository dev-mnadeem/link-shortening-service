# Application
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Leave false unless a reverse proxy you control rewrites X-Forwarded-For.
TRUST_PROXY=false
SHUTDOWN_TIMEOUT_MS=10000

# Storage: mysql (default) or memory (no database; state dies with the process)
STORAGE_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=url_shortener
DB_POOL_SIZE=10

# Short codes
SHORT_CODE_LENGTH=8
SHORT_CODE_MAX_ATTEMPTS=5

# Read-through cache for code -> URL lookups
CACHE_MAX_ENTRIES=10000
CACHE_TTL_MS=300000
CACHE_MISS_TTL_MS=5000

# Click analytics (full | anonymized | none)
CLICK_IP_MODE=full
CLICK_BATCH_SIZE=50
CLICK_FLUSH_MS=1000
CLICK_QUEUE_MAX=10000

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
REDIRECT_RATE_LIMIT_MAX_REQUESTS=600
REDIRECT_RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CLEANUP_MS=60000
RATE_LIMIT_MAX_CLIENTS=100000
